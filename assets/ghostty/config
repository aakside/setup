# =============================================================================
# Ghostty config — portable between Ubuntu (Linux) and macOS.
# Docs: https://ghostty.org/docs/config
# Reload after editing: Ctrl+Shift+, (Linux) / Cmd+Shift+, (macOS)
# =============================================================================

# --- Theme -------------------------------------------------------------------
# Dark background + vibrant, Terminator-style colors. To try another, just
# swap the name below (run `ghostty +list-themes` to preview all 400+):
#   Dracula            (dark grey bg, punchy colors)
#   Catppuccin Mocha   (soft, low-contrast pastel)
#   Gruvbox Dark       (warm, retro)
#   One Half Dark      (clean, VS Code-ish)
theme = Night Lion V2

# Want a pure-black background instead of the theme's near-black? Uncomment:
# background = #000000

# Slight transparency (comment out for fully opaque). background-blur is
# macOS-only and simply ignored on Linux, so it's safe to leave for both.
# background-opacity = 0.96
# background-blur = true

# --- Font --------------------------------------------------------------------
font-family = "DejaVu Sans Mono"
font-size = 12
# Ligatures come free with the font; disable per-feature if you dislike them:
# font-feature = -calt, -liga, -dlig

# --- Comfort / cosmetics -----------------------------------------------------
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true

cursor-style = block
cursor-style-blink = true

mouse-hide-while-typing = true
# copy-on-select: selecting text sends it straight to the clipboard
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true

# ~10 MB of scrollback history
scrollback-limit = 10000000
# reopen windows where you left them
window-save-state = always
# guard against accidentally closing a busy pane
confirm-close-surface = true

# =============================================================================
# Keybindings — Terminator-style, chosen to avoid OS conflicts on BOTH
# Ubuntu and macOS. On macOS "ctrl" below is the Control key (not Cmd), so
# behavior is identical across platforms. Copy/paste (Ctrl+Shift+C/V on Linux,
# Cmd+C/V on macOS) are left at their native defaults.
# =============================================================================

# Move focus between splits — Alt+Arrow (like Terminator). Alt=Option on macOS.
# Deliberately NOT Ctrl+Alt+Arrow, which is Ubuntu's workspace switcher.
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:up
keybind = alt+down=goto_split:down

# Create / close splits (Terminator: E = side-by-side, O = stacked, W = close)
keybind = ctrl+shift+e=new_split:right
keybind = ctrl+shift+o=new_split:down
keybind = ctrl+shift+w=close_surface

# Resize the focused split — Ctrl+Shift+Arrow (Terminator convention)
keybind = ctrl+shift+left=resize_split:left,10
keybind = ctrl+shift+right=resize_split:right,10
keybind = ctrl+shift+up=resize_split:up,10
keybind = ctrl+shift+down=resize_split:down,10

# Maximize/restore the focused split, and even out all splits
keybind = ctrl+shift+x=toggle_split_zoom
keybind = ctrl+shift+equal=equalize_splits

# Tabs (Terminator: Ctrl+Shift+T new; Ctrl+PageUp/Down to move between)
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+page_up=previous_tab
keybind = ctrl+shift+page_down=next_tab

# Font size
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
